# Settings for the TVMaster service. After changing anything here:
#   sudo systemctl restart tvmaster

# Address and port to listen on. Use 127.0.0.1:8787 to keep it to this machine.
#TVMASTER_BIND=0.0.0.0:8787

# Video encoder: software, nvenc, qsv, vaapi or amf. Run `tvmaster doctor` to see
# which ones work on this machine. The default is software (libx264).
#TVMASTER_ENCODER=nvenc

# Stop an on-demand channel after this many seconds without viewers.
#TVMASTER_IDLE_SECONDS=60

# HTTPS. Turn it on to protect the access token on your network. Without a
# certificate of your own, TVMaster makes a self-signed one (kept in
# /var/lib/tvmaster/tls/) and clients trust it by fingerprint: the Mac app shows
# it and remembers your choice, browsers ask you to click through once.
#TVMASTER_TLS=1
#TVMASTER_TLS_BIND=0.0.0.0:8788
# A real certificate, for example from Let's Encrypt or `tailscale cert`; it is
# re-read every few hours so renewals are picked up. The tvmaster user must be able to read both files.
#TVMASTER_TLS_CERT=/etc/tvmaster/tls/fullchain.pem
#TVMASTER_TLS_KEY=/etc/tvmaster/tls/privkey.pem
# Serve only HTTPS. IPTV apps and many smart-TV browsers cannot use a
# self-signed certificate, so keep HTTP on unless you have checked yours can.
#TVMASTER_NO_HTTP=1
